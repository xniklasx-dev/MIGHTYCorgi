@startuml
!pragma teoz true
title UC-05 Collect Item Drops — refined sequence (Task 4)
hide footbox
skinparam backgroundColor white
skinparam sequenceMessageAlign center
skinparam maxMessageSize 65

actor Player
boundary ":GameView" as View
control ":CollectItemDrops" as Collect
entity ":DropRules" as Rules
entity ":WorldPickup" as Pickup
entity ":Inventory" as Inventory
entity ":CharacterEffects" as Effects

note over View,Collect
The game's enemy-defeat / room-event notification
starts this use case. Only analysis objects are shown.
end note
View -> Collect: resolveDrop(rewardEvent)
Collect -> Rules: getRewardRules(rewardEvent)
Rules --> Collect: applicable rules and item definitions

alt [event-specific reward — 2b]
  Collect -> Rules: resolveEventReward(rewardEvent)
  Rules --> Collect: reward item and rarity
else [chance-based reward]
  Collect -> Rules: rollDrop(rewardEvent)
  Rules --> Collect: drop outcome
end

alt [no item awarded — 2a]
  Collect --> View: noPickup()
else [item awarded]
  create Pickup
  Collect -> Pickup: create(itemType, rarity)
  Collect --> View: showPickup(type, rarity)
  View --> Player: Display collectible item

  alt [player leaves item on ground — 4a]
    note over Pickup
      Pickup remains subject to run lifetime rules.
      Despawn timing is not defined.
    end note
  else [player tries to collect]
    Player -> View: collect(pickupId)
    View -> Collect: collect(pickupId)
    Collect -> Pickup: isAvailable()
    Pickup --> Collect: available, item behavior

    alt [already collected / unavailable — 5b]
      Collect --> View: pickupUnavailable()
      View --> Player: Show no item granted
    else [available temporary treat — 5a]
      Collect -> Effects: applyTreat(effectDefinition)
      Effects --> Collect: effect applied
      Collect -> Pickup: markCollected()
      Pickup --> Collect: no longer available
      Collect --> View: showTreatFeedback(effect)
      View --> Player: Display temporary effect
    else [available inventory item]
      Collect -> Inventory: canAccept(item)
      Inventory --> Collect: acceptance result
      alt [inventory cannot accept — 6a]
        Collect --> View: inventoryCannotAccept()
        View --> Player: Show reason; item stays in world
      else [inventory accepts item]
        Collect -> Inventory: addItemOnce(pickupId, item)
        Inventory --> Collect: updated items
        Collect -> Pickup: markCollected()
        Pickup --> Collect: no longer available
        Collect --> View: collectionConfirmed(name, rarity)
        View --> Player: Show feedback / updated inventory
        opt [player inspects item — 7a]
          Player -> View: inspect(itemId)
          View -> Inventory: getItemDetails(itemId)
          Inventory --> View: name, rarity, type, description
          View --> Player: Display item details
        end
      end
    end
  end
end
note over Inventory,Effects
Converting an item into XP (7b) takes place
outside an active run; see UC-05_conversion_Task4.puml.
end note
@enduml
